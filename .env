# Demo environment for PEN-TEST
# This is intentionally local/demo-only and not production-ready.
# Copy values as needed and keep this file out of source control if you are using a real deployment.

# Public URL players use in their browser.
# For a local demo, this can stay on localhost.
CTFD_URL=http://localhost:8000

# Used only when CTFD_URL is blank.
CTFD_SCHEME=http
CTFD_PORT=8000

# Internal URL used by the main Flask app when talking to CTFd inside Docker.
CTFD_INTERNAL_URL=http://ctfd:8000

# Flask app port.
PORT=5000

# --- Hack Club Auth -> CTFd registration (/register) ---
# Keep blank for a demo if you do not want OAuth enabled.
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=

# Public base URL for your main site.
APP_BASE_URL=http://localhost:5000

# Admin API token from the CTFd admin panel.
# Leave blank for a local demo unless you are running CTFd and want provisioning enabled.
CTFD_API_TOKEN=

# Initial arena password shown to players during first-time provisioning.
ARENA_DEFAULT_PASSWORD=demo-password

# REQUIRED: generate a long random string and keep it stable across restarts.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=0d38f4a6f4d6f3ddedf670a9f6d9a8c1170d0a6bbf4c6ad86d5d47a9021e4a8

# Optional: set to 1 when serving behind HTTPS only cookies.
COOKIE_SECURE=0

# Optional: set a shared rate-limit backend when running multiple Gunicorn workers.
RATELIMIT_STORAGE_URI=
