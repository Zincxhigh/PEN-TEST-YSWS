# Production-ready environment template for PEN-TEST
# Copy this file to .env and replace every placeholder before deploying.
# Never commit a real .env file with secrets to Git.

# Public URL players use in their browser.
# In production, usually set this to your public CTFd host, for example:
#   https://ctf.example.com
# If left blank, the app will infer the CTFd URL from the current request host.
CTFD_URL=https://ctf.example.com

# Used only when CTFD_URL is blank.
# Set to https in production behind TLS.
CTFD_SCHEME=https
CTFD_PORT=8000

# Internal URL used by the main Flask app when talking to CTFd inside Docker.
# Leave this as-is for docker-compose deployments.
CTFD_INTERNAL_URL=http://ctfd:8000

# Flask app port.
PORT=5000

# --- Hack Club Auth -> CTFd registration (/register) ---
# Create an OAuth app at auth.hackclub.com and set the redirect URI to:
#   {APP_BASE_URL}/auth/hackclub/callback
# Leave these blank to disable /register gracefully.
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=

# Public base URL for your main site.
# Example: https://www.example.com
APP_BASE_URL=https://www.example.com

# Admin API token from the CTFd admin panel.
# Required for automatic user provisioning when using Hack Club sign-in.
CTFD_API_TOKEN=

# Initial arena password shown to players during first-time provisioning.
# Leave empty to generate a random one-time password instead.
ARENA_DEFAULT_PASSWORD=

# REQUIRED: generate a long random string and keep it stable across restarts.
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET

# Optional: set this to 1 when serving behind HTTPS only cookies.
# Example: for production behind a reverse proxy with HTTPS termination.
COOKIE_SECURE=1

# Optional: set a shared rate-limit backend when running multiple Gunicorn workers.
# Example for Redis: redis://redis:6379/0
# If blank, Flask-Limiter falls back to in-memory storage per process.
RATELIMIT_STORAGE_URI=
