# Public URL players use in their browser (links + redirects on the main site).
# If CTFD_URL is set, it wins. If left empty, server.py derives it per-request
# from the SAME host serving the page: {scheme}://{host}:{CTFD_PORT}
#   Local dev (CTFd nginx on :80):  http://localhost
#   Local dev (direct to CTFd):      http://localhost:8000
#   Production example:              https://play.pen-test.hackclub.com
CTFD_URL=
# Used only when CTFD_URL is empty: same-server scheme + port.
CTFD_SCHEME=http
CTFD_PORT=8000
# Internal URL the main site uses for server-side health checks.
# Inside docker-compose `ctfd` resolves to the CTFd container.
CTFD_INTERNAL_URL=http://ctfd:8000
PORT=5000

# --- Hack Club Auth -> CTFd registration (/register) ---
# 1. Create an OAuth app at auth.hackclub.com (Developer Apps) and set its
#    redirect URI to {APP_BASE_URL}/auth/hackclub/callback
# 2. Generate an admin API token in the CTFd admin panel for CTFD_API_TOKEN.
# Leave the Hack Club vars empty to disable /register gracefully.
HACKCLUB_CLIENT_ID=
HACKCLUB_CLIENT_SECRET=
APP_BASE_URL=http://localhost:5000
CTFD_API_TOKEN=
# Initial arena password shown to players (they're prompted to change it in
# CTFd Settings). Empty = random one-time password shown once instead.
ARENA_DEFAULT_PASSWORD=
SECRET_KEY=change-me-to-something-random
